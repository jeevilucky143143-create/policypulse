# ==============================================================================
# Environment Configuration Template for Complaint Response Assistant (PS-40)
# ==============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# Server & Runtime Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# CORS Configuration (comma-separated origins or JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration (Supabase PostgreSQL with pgvector)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[DB_HOST]:5432/postgres
# For session pooler / direct connection:
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Client Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=policy-documents

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_GENERATION_MODEL=gemini-3.8-flash
# Embedding model candidate (subject to verification via smoke test)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Output dimensions for embedding model (must match database vector column)
EMBEDDING_DIMENSIONS=768
