# ==============================================================================
# PolicyPulse AI — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Settings (Vite)
# ------------------------------------------------------------------------------
# URL of the backend FastAPI service
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Whether to enable automatic rich illustrative demo fallback if backend is offline
VITE_ENABLE_DEMO_FALLBACK=true

# ------------------------------------------------------------------------------
# Backend Settings (FastAPI & Uvicorn)
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://policypulse.vercel.app

# ------------------------------------------------------------------------------
# Database & Vector Store (Supabase PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_STORAGE_BUCKET=policy-documents

# ------------------------------------------------------------------------------
# AI Provider & Model Configuration (Hosted API)
# ------------------------------------------------------------------------------
# LLM Provider Key (OpenAI or Google Gemini)
OPENAI_API_KEY=sk-placeholder-do-not-commit-real-keys
# GEMINI_API_KEY=your-gemini-api-key-here

# Model Identifiers
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
RRF_K_PARAMETER=60
